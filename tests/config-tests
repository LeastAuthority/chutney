#!/usr/bin/env python3

import glob
import subprocess
import sys
import textwrap

from chutney import TorNet
from chutney.TorNet import NodeConfig
from pathlib import Path

network = TorNet.Network()

# Generate configs for all[^1] torrc templates, using their legacy names.
#
# [^1]: Except for the ones in the explicit `skip` list; see below.
configs = [
    NodeConfig(
        torrc="authority-orport-v6.tmpl",
        tag="a",
        authority=True,
        relay=True,
        ipv6_addr="[::1]",
    ),
    NodeConfig(
        torrc="authority.tmpl",
        tag="a",
        authority=True,
        relay=True,
    ),
    NodeConfig(
        torrc="bridgeauthority.tmpl",
        tag="ba",
        authority=True,
        relay=True,
        bridgeauthority=True,
    ),
    NodeConfig(
        torrc="bridgeclient-obfs4.tmpl",
        tag="bc",
        client=True,
        # Managed proxies are incompatible with sandboxing
        sandbox=False,
    ),
    NodeConfig(
        torrc="bridgeclient.tmpl",
        tag="bc",
        client=True,
        # Managed proxies are incompatible with sandboxing
        sandbox=False,
    ),
    NodeConfig(
        torrc="bridge-obfs4.tmpl",
        tag="br",
        bridge=True,
        pt_bridge=True,
        relay=True,
        pt_transport="obfs4",
        # Managed proxies are incompatible with sandboxing
        sandbox=False,
    ),
    NodeConfig(
        torrc="bridge.tmpl",
        tag="br",
        bridge=True,
        relay=True,
    ),
    NodeConfig(
        torrc="bridge-v6.tmpl",
        tag="br",
        bridge=True,
        relay=True,
        ipv6_addr="[::1]",
    ),
    NodeConfig(
        torrc="client_bwscanner.tmpl",
        tag="c",
        client=True,
    ),
    NodeConfig(
        torrc="client-only-v6-md.tmpl",
        tag="c",
        client=True,
        ipv6_addr="[::1]",
    ),
    NodeConfig(
        torrc="client-only-v6.tmpl",
        tag="c",
        client=True,
        ipv6_addr="[::1]",
    ),
    NodeConfig(
        torrc="client.tmpl",
        tag="c",
        client=True,
    ),
    NodeConfig(
        torrc="hs-v3-only-v6-md.tmpl",
        tag="h",
        hs=True,
        ipv6_addr="[::1]",
    ),
    NodeConfig(
        torrc="hs-v3-only-v6.tmpl",
        tag="h",
        hs=True,
        ipv6_addr="[::1]",
    ),
    NodeConfig(
        torrc="hs-v3.tmpl",
        tag="h",
        hs=True,
    ),
    NodeConfig(
        torrc="relay-MAB.tmpl",
        tag="relay1mbyteMAB",
        relay=True,
        exit=True,
    ),
    NodeConfig(
        torrc="relay-MBR.tmpl",
        tag="relay1mbyteMBR",
        relay=True,
        exit=True,
    ),
    NodeConfig(
        torrc="relay-non-dir.tmpl",
        tag="r",
        relay=True,
        exit=True,
    ),
    NodeConfig(
        torrc="relay-non-exit.tmpl",
        tag="r",
        relay=True,
        exit=False,
    ),
    NodeConfig(
        torrc="relay-exit-v6-only.tmpl",
        tag="r",
        relay=True,
        exit=True,
